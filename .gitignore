# ============================================
# LUMOSS .gitignore
# ============================================

# --- Data & Output (JANGAN di-commit) ---
accounts/*/
!accounts/active.json
output/
cache/
backup/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/

# --- OS & Editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# --- Log & Temp ---
*.log
*.tmp
*.bak
*.cache
.thumbnails/

# --- Env & Secret ---
.env
.env.local
*.key
*.pem

# --- Script sekali pakai ---
fix_emoji.py

# --- File binary & arsip ---
*.zip
*.tar.gz
*.rar

# --- File deprecated ---
templates/about.html